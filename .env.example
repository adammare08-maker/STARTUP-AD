EMAIL_API_KEY=re_your_private_api_key
CONTACT_TO_EMAIL=votre-adresse@exemple.fr
CONTACT_FROM_EMAIL=STARTUP/AD <contact@YOUR_VERIFIED_DOMAIN>
CONTACT_SEND_CONFIRMATION=false

# Gmail API — server only; never prefix private values with NEXT_PUBLIC_
GMAIL_CLIENT_ID=YOUR_GOOGLE_OAUTH_CLIENT_ID
GMAIL_CLIENT_SECRET=YOUR_GOOGLE_OAUTH_CLIENT_SECRET
GMAIL_REDIRECT_URI=https://YOUR_STARTUP_AD_DOMAIN/api/auth/gmail/callback
GMAIL_TOKEN_ENCRYPTION_KEY=YOUR_RANDOM_PRIVATE_ENCRYPTION_KEY

# Supabase — les clés secrètes restent exclusivement côté serveur
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_PRIVATE_SERVICE_ROLE_KEY
ADMIN_EMAIL=votre-adresse-admin@exemple.fr
ADMIN_USER_ID=UUID_DU_COMPTE_ADAM_CONFIRME

# Stripe Checkout et webhook
STRIPE_SECRET_KEY=sk_test_YOUR_PRIVATE_KEY
STRIPE_WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SECRET
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_YOUR_PUBLIC_KEY
NEXT_PUBLIC_SITE_URL=https://YOUR_STARTUP_AD_DOMAIN
